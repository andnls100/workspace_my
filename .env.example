# 文本分析 API：负责字段提取、合同内部检查与跨文件比较
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=

# 多模态 API：扫描 PDF 页面图片中的文字及隐私信息；页面图像会发送给此 API
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://api.openai.com/v1
MULTIMODAL_MODEL=

API_TIMEOUT=120
API_RETRIES=2
# 最多进行多模态 OCR 的 PDF 页面数；含嵌入图片或文本层不足的页面会优先检查
VISION_MAX_PAGES=30
