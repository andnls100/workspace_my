# 文本分析 API：负责字段提取、合同内部检查与跨文件比较
TEXT_API_KEY=
TEXT_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=

# 多模态 API：检查 PDF 页面中的签字/盖章、未脱敏隐私和明显错别字；页面图像会发送给此 API
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=https://api.openai.com/v1
MULTIMODAL_MODEL=

# 是否对合同执行多模态图像检查；true/未设置=开启，false=关闭（本地文本扫描仍执行）
CHECK_CONTRACT_MULT=true

API_TIMEOUT=120
API_RETRIES=2
# 兼容保留的多模态页面配置项
VISION_MAX_PAGES=30

# DeepSeek 教师 API：用于蒸馏数据生成（不会下载教师模型权重）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 先运行 python -m distill.scripts.check_teacher_api 查看账户实际可用模型
DEEPSEEK_MODEL=
